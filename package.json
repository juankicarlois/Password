{
  "name": "password-accesible",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Juego del Password accesible con lectores de pantalla, jugable en solitario contra la IA o en red.",
  "scripts": {
    "build:client": "esbuild client/main.ts --bundle --format=esm --outfile=public/app.js --sourcemap",
    "watch:client": "esbuild client/main.ts --bundle --format=esm --outfile=public/app.js --sourcemap --watch",
    "server": "tsx server/index.ts",
    "dev": "npm run build:client && tsx server/index.ts",
    "tunnel": "node scripts/tunnel.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test shared/rules.test.ts server/words_repo.test.ts server/engine.test.ts server/plans.test.ts server/bot.test.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
